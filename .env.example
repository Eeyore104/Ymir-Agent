# ymir-agent 环境变量样例（复制为 .env 后按需修改；.env 不入库）
# 所有变量均以 YMIR_ 前缀覆盖 pydantic-settings 的默认值（见 src/ymir/config.py）

# --- 应用 ---
YMIR_APP_NAME=ymir-agent
YMIR_API_PREFIX=/api/v1
YMIR_DEBUG=false

# --- 单租户扩展点（MVP 恒为 default）---
YMIR_DEFAULT_TENANT_ID=default

# --- 数据存储（相对路径按仓库根目录解析）---
YMIR_DB_PATH=data/ymir.db
YMIR_ARTIFACTS_DIR=data/artifacts

# --- 默认流水线与运行模式 ---
YMIR_DEFAULT_PIPELINE_ID=software-dev
YMIR_DEFAULT_RUN_MODE=key_node

# --- 沙箱镜像（须由 docker/sandbox.Dockerfile 构建；内置 pytest+ruff，基准预检必需；
#     v1.2 起扩容 fastapi/uvicorn/sqlalchemy/aiosqlite/alembic 供模板依赖离线 import）---
YMIR_SANDBOX_IMAGE=ymir-sandbox:latest

# --- 模型网关（T02 起使用；密钥只走环境变量，禁止入库/入日志）---
DEEPSEEK_API_KEY=

# --- GitHub 推送（v1.2；token 只走环境变量，禁止写进请求体）---
# `GITHUB_TOKEN`：仅需目标 repo 的 `repo` scope；fine-grained token 授予
# Contents: Read and write。**禁止提交本文件**（真实 token 只放本地 .env）。
GITHUB_TOKEN=
